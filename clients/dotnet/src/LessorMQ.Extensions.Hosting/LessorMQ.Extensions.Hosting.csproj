<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LessorMQ.Extensions.Hosting</RootNamespace>
    <PackageId>LessorMQ.Extensions.Hosting</PackageId>
    <Description>LessorMQ for Microsoft.Extensions.Hosting and ASP.NET Core: services.AddLessorMQ(...) with options from configuration, and handlers that run as hosted workers. Retries stay with the LessorMQ server.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LessorMQ/LessorMQ.csproj" />
  </ItemGroup>

  <!-- The lowest version of the major, so an application's own (or ASP.NET Core's) wins. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

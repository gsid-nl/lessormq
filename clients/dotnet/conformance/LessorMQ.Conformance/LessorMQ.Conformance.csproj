<Project Sdk="Microsoft.NET.Sdk">

  <!-- The conformance adapter: one JSON request per line on stdin, one result per line on stdout. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LessorMQ/LessorMQ.csproj" />
  </ItemGroup>

</Project>

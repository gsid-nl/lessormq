<Project>
  <!-- Shared by every project in clients/dotnet. The release overrides Version with the
       one in the tag: dotnet pack -p:Version=1.2.3. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Authors>LessorMQ</Authors>
    <Copyright>LessorMQ contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://lessormq.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gsid-nl/lessormq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>lessormq;message-queue;job-queue;worker;http</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
